      "card": "level0 + surfaceContainer fill",
      "navBar": "level2 + glass",
      "fab": "level3",
      "sheet": "level1",
      "dialog": "level3"
    }
  },
  "motion": {
    "duration": {
      "short": 150,
      "medium": 300,
      "long": 450,
      "analyzingMax": 2500
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0,0,1)",
      "emphasizedDecelerate": "cubic-bezier(0.05,0.7,0.1,1)",
      "emphasizedAccelerate": "cubic-bezier(0.3,0,0.8,0.15)",
      "spring": {
        "damping": 0.8,
        "stiffness": 380
      }
    },
    "reduceMotion": "replace movement with 150 ms fades; no looping animation (MediaQuery.disableAnimations)"
  },
  "tapTarget": {
    "min": 48
  },
  "glass": {
    "light": {
      "fill": "rgba(255,252,245,0.78)",
      "blur": 16,
      "border": "rgba(59,42,30,0.10)"
    },
    "dark": {
      "fill": "rgba(31,26,21,0.78)",
      "blur": 16,
      "border": "rgba(241,232,218,0.10)"
    },
    "cameraOverlay": {
      "fill": "rgba(23,19,15,0.62)",
      "text": "#FFFFFF",
      "blur": 12,
      "minContrast": "9.3:1 worst case over light fabric"
    }
  },
  "photoScrim": {
    "gradient": "linear 180deg, transparent 35% -> rgba(23,19,15,0.82) 100%",
